# 百度网盘开放平台应用配置。复制为 .env.local 后填写真实值。
BAIDU_PAN_APP_KEY=
BAIDU_PAN_APP_SECRET=
BAIDU_PAN_REDIRECT_URI=http://127.0.0.1:3100/api/materials/baidu/callback

# 建议在百度网盘中为红序准备单独的素材根目录。
BAIDU_PAN_ROOT_PATH=/

# 本机只保存近期使用的受管缓存，默认位于 runner/data/material-cache。
MATERIAL_CACHE_MAX_GB=80
# MATERIAL_CACHE_DIR=/Volumes/素材盘/红序缓存

# 如果网页工作台部署在其他域名，可在这里增加允许访问本机执行器的来源，多个来源用英文逗号分隔。
# RUNNER_ALLOWED_ORIGINS=https://your-rednote-site.example
